# public_html/.htaccess
RewriteEngine On

# 1. Force HTTPS + non-www for main domain
RewriteCond %{HTTP_HOST} ^www\.the-web\.co\.za$ [NC]
RewriteRule ^(.*)$ https://the-web.co.za/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^the-web\.co\.za$ [NC]
RewriteRule ^(.*)$ https://the-web.co.za/$1 [L,R=301]

# 2. Quasar/Vue routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]